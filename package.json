{
  "name": "ebp-address-base-updater",
  "version": "2.0.0",
  "description": "Node scripts to update the address base copy the Energy Performance of Buildings Register service uses",
  "main": "address-base.js",
  "directories": {
    "lib": "lib"
  },
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "fmt": "prettier . --write",
    "lint": "prettier . --check && eslint",
    "test": "NODE_OPTIONS='--experimental-vm-modules' NODE_NO_WARNINGS=1 jest",
    "update-address-base-auto": "node address-base.mjs update",
    "full-address-base-reload": "node address-base.mjs install",
    "get-address-base-version": "node address-base.mjs versions",
    "setup-db": "node tests/support/setup-database.mjs",
    "start": "echo 'DO NOT REMOVE. Required by Paketo to enable the node entrypoint' | cat > /dev/null &&"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/communitiesuk/epb-update-address-base.git"
  },
  "author": "@communitiesuk/epb",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/communitiesuk/epb-update-address-base/issues"
  },
  "homepage": "https://github.com/communitiesuk/epb-update-address-base#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dedent": "^1.7.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "debug": "^4.4.3",
    "pg": "^8.13.0",
    "pg-promise": "^12.7.1",
    "unzipper": "^0.12.5"
  }
}
